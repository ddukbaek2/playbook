{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Live Server",
			"type": "shell",
			"command": "${command:extension.liveServer.goOnline}",
			"problemMatcher": []
		},
		{
			"label": "Build",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/tools/build.js"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Deploy",
			"type": "shell",
			"command": "node",
			"args": [
				"${workspaceFolder}/tools/deploy.js"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Build and Deploy",
			"dependsOrder": "sequence",
			"dependsOn": ["Build", "Deploy"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
